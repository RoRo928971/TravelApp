# 旅のしおり — 環境変数のサンプル
# このファイルを .env にコピーして値を入れてください。
# すべて未設定でもローカルモード（端末内保存＋モックデータ）でアプリは動きます。

# --- Supabase（設定するとクラウドモード：認証・同期・リアルタイム共同編集）---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- 場所検索（Foursquare Places API。未設定ならモックの場所DBを使用）---
# https://foursquare.com/developers/ で取得
EXPO_PUBLIC_FOURSQUARE_API_KEY=
